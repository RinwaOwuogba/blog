---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Bolarinwa 👋</h1>
			<p>
				I'm an engineer in Lagos, six years building full-stack software, mostly in and around money
				(fintech, crypto). I like that world, but even more than that, I love building.
			</p>
			<p>
				This is where I write about engineering, web3, and how building software is changing in the
				agentic era. Start with the <a href="/blog">blog</a>, or read a bit
				<a href="/about">about me</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
